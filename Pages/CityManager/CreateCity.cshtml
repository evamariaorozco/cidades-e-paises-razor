@page
@model CreateCityModel
@{
    ViewData["Title"] = "Cadastrar Cidade";
}

<h1>Cadastrar Cidade</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.CityName" class="form-label">Nome da cidade</label>
        <input asp-for="Input.CityName" class="form-control" />
        <span asp-validation-for="Input.CityName" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Enviar</button>
</form>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <p class="mt-3">@Model.Mensagem</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
