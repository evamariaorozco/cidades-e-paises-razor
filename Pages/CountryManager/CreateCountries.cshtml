@page
@model CreateCountriesModel
@{
    ViewData["Title"] = "Cadastrar Vários Países";
}

<h1>Cadastrar Vários Países</h1>

<form method="post">
    @for (int i = 0; i < Model.Inputs.Count; i++)
    {
        <div class="row mb-3">
            <div class="col">
                <label asp-for="Inputs[i].CountryName" class="form-label">Nome do país @(i + 1)</label>
                <input asp-for="Inputs[i].CountryName" class="form-control" />
                <span asp-validation-for="Inputs[i].CountryName" class="text-danger"></span>
            </div>
            <div class="col">
                <label asp-for="Inputs[i].CountryCode" class="form-label">Código do país @(i + 1)</label>
                <input asp-for="Inputs[i].CountryCode" class="form-control" maxlength="3" />
                <span asp-validation-for="Inputs[i].CountryCode" class="text-danger"></span>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary">Enviar</button>
</form>

@if (Model.Paises.Count > 0)
{
    <h2 class="mt-4">Países cadastrados</h2>
    <ul>
        @foreach (var pais in Model.Paises)
        {
            <li>@pais.CountryName - @pais.CountryCode</li>
        }
    </ul>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
