@page
@model SaveNoteModel
@{
    ViewData["Title"] = "Salvar Nota";
}

<h1>Salvar Nota</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Content" class="form-label">Texto da nota</label>
        <textarea asp-for="Input.Content" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Input.Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
</form>

@if (!string.IsNullOrEmpty(Model.NomeArquivo))
{
    <p class="mt-3">Nota salva com sucesso: @Model.NomeArquivo</p>
    <a href="~/files/@Model.NomeArquivo" download>Baixar arquivo</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
